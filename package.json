{
  "name": "qracer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.14.0"
  },
  "scripts": {
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:budgets && pnpm check:licenses",
    "check:worker": "node scripts/smoke-worker.mjs",
    "test:e2e": "playwright test",
    "prepare": "node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:pr": "node scripts/check-pr.mjs",
    "dev:worker": "pnpm --filter @qracer/relay-cloudflare dev",
    "dev:local": "pnpm --filter @qracer/relay-local dev",
    "test": "vitest run",
    "dev": "pnpm --filter @qracer/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tools.json",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:licenses": "node scripts/licenses.mjs",
    "package:local": "pnpm build && node scripts/package-local.mjs && node scripts/smoke-package.mjs",
    "check:package": "node scripts/smoke-package.mjs",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "vitest": "5.1.1",
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
